    "Input": "Lifetime Min",
    "Value": "1.0"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "Module": "Initialize Particle",
    "Input": "Lifetime Max",
    "Value": "2.0"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "Module": "Initialize Particle",
    "Input": "Sprite Size Mode",
    "Value": "Random Uniform"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "Module": "Initialize Particle",
    "Input": "Uniform Sprite Size Min",
    "Value": "4"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "Module": "Initialize Particle",
    "Input": "Uniform Sprite Size Max",
    "Value": "10"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "Module": "Color",
    "Input": "Color",
    "Value": "=lerp(lerp(float4(0.3, 0.9, 1, 0), float4(0.4, 0.8, 1, 1), saturate(Particles.NormalizedAge / 0.3)), float4(0.6, 0.3, 1, 0), saturate((Particles.NormalizedAge - 0.3) / (1.0 - 0.3)))"
   }
  }
 ]
