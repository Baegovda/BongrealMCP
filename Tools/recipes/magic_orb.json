{
 "name": "magic_orb",
 "description": "Cyan-to-violet motes swirling around and drawn toward the center (vortex + point attraction).",
 "placeholders": {
  "SystemPath": "/Game/FX/NS_MagicOrb",
  "SpriteMaterial": "/Niagara/DefaultAssets/DefaultSpriteMaterial.DefaultSpriteMaterial"
 },
 "usage": "Replace every {{Placeholder}} (defaults above), turn each Arguments object into a JSON string and run the operations with ExecuteBatch(Operations, Expect=expect). Python: McpClient().recipe(name, SystemPath=...).",
 "expect": "Compiles:{{SystemPath}};Valid:{{SystemPath}};Particles:{{SystemPath}}:Any@0.5>=1",
 "operations": [
  {
   "Id": "sys",
   "Tool": "CreateSystem",
   "Arguments": {
    "AssetPath": "{{SystemPath}}"
   }
  },
  {
   "Tool": "AddEmitter",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "TemplateEmitter": "Minimal"
   }
  },
  {
   "Tool": "SetRendererProperty",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "RendererIndex": 0,
    "PropertyName": "Material",
    "Value": "{{SpriteMaterial}}"
   }
  },
  {
   "Tool": "AddModule",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "StackName": "EmitterUpdate",
    "ModuleScript": "/Niagara/Modules/Emitter/SpawnRate.SpawnRate"
   }
  },
  {
   "Tool": "AddModule",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "StackName": "ParticleSpawn",
    "ModuleScript": "/Niagara/Modules/Spawn/Location/SphereLocation.SphereLocation"
   }
  },
  {
   "Tool": "AddModule",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "StackName": "ParticleUpdate",
    "ModuleScript": "/Niagara/Modules/Update/Forces/VortexForce.VortexForce"
   }
  },
  {
   "Tool": "AddModule",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "StackName": "ParticleUpdate",
    "ModuleScript": "/Niagara/Modules/Update/Forces/PointAttractionForce.PointAttractionForce"
   }
  },
  {
   "Tool": "AddModule",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "StackName": "ParticleUpdate",
    "ModuleScript": "/Niagara/Modules/Update/Forces/Drag.Drag"
   }
  },
  {
   "Tool": "AddModule",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "StackName": "ParticleUpdate",
    "ModuleScript": "/Niagara/Modules/Solvers/SolveForcesAndVelocity.SolveForcesAndVelocity"
   }
  },
  {
   "Tool": "AddModule",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "StackName": "ParticleUpdate",
    "ModuleScript": "/Niagara/Modules/Update/Color/Color.Color"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "Module": "Spawn Rate",
    "Input": "SpawnRate",
    "Value": "90"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "Module": "Sphere Location",
    "Input": "Sphere Radius",
    "Value": "60"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Motes",
    "Module": "Drag",
    "Input": "Drag",
    "Value": "0.6"
   }
  },
  {
