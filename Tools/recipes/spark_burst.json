{
 "name": "spark_burst",
 "description": "One-shot burst of 80 velocity-aligned sparks flung outwards that fall with gravity and drag.",
 "placeholders": {
  "SystemPath": "/Game/FX/NS_SparkBurst",
  "SpriteMaterial": "/Niagara/DefaultAssets/DefaultSpriteMaterial.DefaultSpriteMaterial"
 },
