   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Sparks",
    "Module": "Initialize Particle",
    "Input": "Lifetime Max",
    "Value": "1.2"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Sparks",
    "Module": "Color",
    "Input": "Color",
    "Value": "=lerp(lerp(float4(1, 0.95, 0.7, 1), float4(1, 0.6, 0.15, 1), saturate(Particles.NormalizedAge / 0.5)), float4(0.9, 0.2, 0.05, 0), saturate((Particles.NormalizedAge - 0.5) / (1.0 - 0.5)))"
   }
