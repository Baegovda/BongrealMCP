{
 "name": "impact_flash",
 "description": "One-shot impact: a 0.25 s bright flash plus a ring of fast sparks slowed by drag.",
 "placeholders": {
  "SystemPath": "/Game/FX/NS_ImpactFlash",
  "SpriteMaterial": "/Niagara/DefaultAssets/DefaultSpriteMaterial.DefaultSpriteMaterial"
 },
 "usage": "Replace every {{Placeholder}} (defaults above), turn each Arguments object into a JSON string and run the operations with ExecuteBatch(Operations, Expect=expect). Python: McpClient().recipe(name, SystemPath=...).",
