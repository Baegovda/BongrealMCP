   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Flash",
    "Module": "Spawn Burst Instantaneous",
    "Input": "Spawn Count",
    "Value": "1"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Flash",
    "Module": "Initialize Particle",
    "Input": "Lifetime",
    "Value": "0.25"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Flash",
    "Module": "Initialize Particle",
    "Input": "Sprite Size Mode",
    "Value": "Uniform"
   }
  },
  {
   "Tool": "SetModuleInput",
