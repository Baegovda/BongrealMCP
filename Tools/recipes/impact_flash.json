    "Value": "=lerp(lerp(float4(1, 1, 0.9, 1), float4(1, 0.7, 0.3, 0.6), saturate(Particles.NormalizedAge / 0.3)), float4(1, 0.3, 0.1, 0), saturate((Particles.NormalizedAge - 0.3) / (1.0 - 0.3)))"
   }
