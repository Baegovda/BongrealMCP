   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Flash",
    "RendererIndex": 0,
    "PropertyName": "Material",
    "Value": "{{SpriteMaterial}}"
   }
  },
  {
   "Tool": "AddModule",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Flash",
    "StackName": "EmitterUpdate",
    "ModuleScript": "/Niagara/Modules/Emitter/SpawnBurst_Instantaneous.SpawnBurst_Instantaneous"
   }
  },
  {
   "Tool": "AddModule",
   "Arguments": {
    "System": "{{SystemPath}}",
    "EmitterName": "Flash",
    "StackName": "ParticleUpdate",
    "ModuleScript": "/Niagara/Modules/Update/Color/Color.Color"
   }
  },
  {
   "Tool": "SetModuleInput",
   "Arguments": {
